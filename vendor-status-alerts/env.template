# ================================================================
# vendor-status-alerts
# Adobe Status and CISA are public, so the app runs with this file empty.
# Fill a block below to turn on mail or Microsoft 365.
# ================================================================

# --- Mail (optional) ---
# A JSON list of Apprise URIs (https://github.com/caronc/apprise/wiki).
# Without it the app fills the database and sends nothing.
## Amazon SES, the scheme AutoIDM customer projects use:
# TARGET_APPRISE_URIS=["ses://alerts@example.com/ACCESS_KEY_ID/SECRET_ACCESS_KEY/us-east-1/it-team@example.com/"]
## Any SMTP server. mailtos:// is TLS. Escape @ in the user name as %40.
# TARGET_APPRISE_URIS=["mailtos://user%40example.com:password@smtp.example.com:465?from=alerts@example.com&to=it-team@example.com"]
## Microsoft Teams, Slack, and more than 100 other services work the same way.
TARGET_APPRISE_URIS=

# --- Microsoft 365 service health (optional) ---
# An Entra app registration with the application permissions
# ServiceHealth.Read.All and ServiceMessage.Read.All, and admin consent.
# Without PDT_AZURE_TENANT_ID the app skips Microsoft 365.
PDT_AZURE_TENANT_ID=
PDT_AZURE_CLIENT_ID=

# Entra ID auth: pick ONE mode
## Mode A — client secret
PDT_AZURE_CLIENT_SECRET=
## Mode B — certificate (PFX). Wins if both modes are set.
### A relative path is relative to the project root, e.g. .secrets/app.pfx
PDT_AZURE_PRIVATE_KEY_PATH=
### Or inline the PFX as base64 of the file; wins over the path.
### Deploy converts PDT_AZURE_PRIVATE_KEY_PATH into this secret automatically.
PDT_AZURE_PRIVATE_KEY_B64=
## Optional; omit if the PFX is unencrypted.
PDT_AZURE_PRIVATE_KEY_PASSWORD=
