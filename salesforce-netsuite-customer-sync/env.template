# ================================================================
# salesforce-netsuite-customer-sync
# Salesforce user needs API Enabled plus read on Account and Contact.
# NetSuite needs an integration record with REST Web Services and the
# OAuth 2.0 client credentials grant, mapped to an Administrator role.
# DuckDB holds the staging tables between the two systems.
# ================================================================

# --- Salesforce: pick ONE mode ---
## Mode A -- user name, password, and security token
TAP_SALESFORCE_USERNAME=
TAP_SALESFORCE_PASSWORD=
TAP_SALESFORCE_SECURITY_TOKEN=
## Mode B -- external client app with a refresh token
## retrieve_sf_refresh_token.sh fills the refresh token from the first two.
TAP_SALESFORCE_CLIENT_ID=
TAP_SALESFORCE_CLIENT_SECRET=
TAP_SALESFORCE_REFRESH_TOKEN=
# Optional; the My Domain login host that the token script uses. The script has this default.
SF_LOGIN_URL=https://resourceful-panda-wslf1r-dev-ed.trailblaze.my.salesforce.com
# Optional; how far back the first read goes. meltano.yml sets a default.
TAP_SALESFORCE_START_DATE=
# Optional; path to a refresh_token_store_hook executable that keeps a second copy of the
# rotating token. The tap itself keeps the current one in
# $XDG_DATA_HOME/autoidm/<app>/salesforce_refresh_token.json and reads it first.
# scripts/sf-refresh-token-keyvault.py (the app's deployed secret, or this .env file
# on your own computer; the default set by run.py) or
# scripts/sf-refresh-token-gitlab.py (a GitLab CI/CD variable).
TAP_SALESFORCE_REFRESH_TOKEN_STORE_HOOK=
## Only needed with sf-refresh-token-gitlab.py.
# GITLAB_TOKEN=        # Project access token, api scope, Maintainer role.
# GITLAB_VARIABLE_KEY= # Variable name; defaults to TAP_SALESFORCE_REFRESH_TOKEN.
# GITLAB_VARIABLE_ENVIRONMENT_SCOPE= # Optional; scopes the variable to one environment.

# --- NetSuite read (always) ---
# Account ID is the first part of your NetSuite URL, for example 1234567.
TAP_NETSUITE_ACCOUNT_ID=
TAP_NETSUITE_CLIENT_ID=
TAP_NETSUITE_CERTIFICATE_ID=
# The PEM private key text itself, not a path to it.
# A deployed job holds only string secrets, so a file path cannot reach it.
TAP_NETSUITE_PRIVATE_KEY=

# --- NetSuite write (always) ---
# The same integration record covers both reading and writing.
TARGET_NETSUITE_ACCOUNT_ID=
TARGET_NETSUITE_CLIENT_ID=
TARGET_NETSUITE_CERTIFICATE_ID=
TARGET_NETSUITE_PRIVATE_KEY=

# --- DuckDB (always) ---
# run.py sets this path to a fresh per-run file under the state directory.
DUCKDB_PATH=
